{
  "name": "tasks.testerhub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "zero:cutover:check": "tsx scripts/zero-cutover-rehearsal.ts",
    "zero:production:cutover": "tsx scripts/zero-production-cutover.ts",
    "zero:permissions:check": "tsx scripts/zero-stage2-permissions-check.ts",
    "zero:rest:check": "tsx scripts/zero-stage4-rest-check.ts",
    "mcp:dev": "npm --workspace @testerhub/pulsar-mcp run dev",
    "mcp:build": "npm --workspace @testerhub/pulsar-mcp run build",
    "mcp:start": "npm --workspace @testerhub/pulsar-mcp run start",
    "backfill:keys": "node scripts/backfill-issue-keys.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@rocicorp/zero": "1.8.0",
    "@uiw/react-md-editor": "^4.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^11.3.30",
    "next": "16.2.12",
    "pg": "^8.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@prisma/dev": {
      "find-my-way": "9.7.0",
      "valibot": "1.4.2"
    },
    "eslint-plugin-react-hooks": "7.0.1",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }

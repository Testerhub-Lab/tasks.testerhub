# Docker Compose interpolation only. Keep the real file outside the repository
# with mode 600, for example /srv/tasks/production.env.
PULSAR_APP_ENV_FILE=/srv/tasks/.env
PULSAR_APP_DB_PASSWORD=replace-with-a-long-random-hex-value
PULSAR_ZERO_DB_PASSWORD=replace-with-a-different-long-random-hex-value
PULSAR_WEB_IMAGE=ghcr.io/testerhub-lab/tasks.testerhub:latest
APP_PORT=3012
UPLOAD_DATA_DIR=/srv/tasks/data/uploads

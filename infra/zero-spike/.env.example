POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
ZERO_ADMIN_PASSWORD=replace-with-a-different-long-random-hex-value
S3_SECRET_ACCESS_KEY=replace-with-a-third-long-random-value

# These ports bind to server loopback and are reached through an SSH tunnel.
ZERO_STAGE2_APP_PORT=3013
ZERO_CACHE_PORT=4848
NEXT_PUBLIC_ZERO_CACHE_URL=http://localhost:4848

# The automated gate runs inside the app container. Override with the public
# FirstVDS endpoint outside this isolated contour.
S3_PUBLIC_ENDPOINT=http://s3:9000
S3_REGION=us-east-1
S3_BUCKET=pulsar-zero-attachments
S3_ACCESS_KEY_ID=pulsar-zero

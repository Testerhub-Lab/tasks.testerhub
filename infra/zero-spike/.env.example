POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
ZERO_ADMIN_PASSWORD=replace-with-a-different-long-random-hex-value

# Existing Pulsar database, used only to validate the current cookie session.
DATABASE_URL=postgresql://tasks_app:replace-me@host.docker.internal:5432/tasks_testerhub

# These ports bind to server loopback and are reached through an SSH tunnel.
ZERO_SPIKE_APP_PORT=3013
ZERO_CACHE_PORT=4848
NEXT_PUBLIC_ZERO_CACHE_URL=http://localhost:4848

# Copy to .env.local and use distinct local-only passwords.
PULSAR_ZERO_DB_PASSWORD=replace_with_random_hex
PULSAR_APP_DB_PASSWORD=replace_with_different_random_hex
ZERO_ADMIN_PASSWORD=replace_with_different_random_hex
S3_ACCESS_KEY_ID=pulsar-local
# LocalStack validates presigned URLs against its default test secret.
S3_SECRET_ACCESS_KEY=test

# Host-side seed/verification tools; use the passwords above in these URLs.
LOCAL_ZERO_QA=true
ZERO_UPSTREAM_DB=postgresql://pulsar_zero:replace_with_random_hex@127.0.0.1:55433/pulsar
DATABASE_URL=postgresql://pulsar_app:replace_with_different_random_hex@127.0.0.1:55433/pulsar
PULSAR_AUTH_STORE=zero
S3_ENDPOINT=http://127.0.0.1:9010
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9010
S3_REGION=us-east-1
S3_BUCKET=pulsar-local-attachments
S3_FORCE_PATH_STYLE=true

DATABASE_URL="postgresql://user:password@localhost:5432/tasks_tracker"

# Keep `legacy` until the rehearsed production cutover. The isolated Zero
# contour sets this to `zero`.
PULSAR_AUTH_STORE=legacy

# Optional signed workspace invite links
WORKSPACE_INVITE_SECRET=

# Private S3-compatible attachment storage (server-only).
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

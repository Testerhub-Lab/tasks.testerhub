generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id             String    @id @default(cuid())
  title          String
  description    String?
  type           String    @default("TASK")
  priority       Priority  @default(MEDIUM)
  status         Status    @default(NEW)
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  creatorId      String?
  creator        User?     @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  reporterId     String?
  reporter       User?     @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  requesterName  String?
  requesterEmail String?
  dueDate        DateTime?
  tags           String[]  @default([])
  attachments    String[]  @default([])
  projectId      String
  number         Int
  key            String    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  project        Project         @relation(fields: [projectId], references: [id])
  comments       Comment[]
  activities     TaskActivity[]
  knowledgeLinks KnowledgeLink[]

  @@unique([projectId, number])
}

model TaskActivity {
  id         String       @id @default(uuid())
  taskId     String
  type       ActivityType
  userId     String?
  authorName String?
  fromStatus Status?
  toStatus   Status?
  createdAt  DateTime     @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([userId])
}

model Comment {
  id         String   @id @default(uuid())
  taskId     String
  text       String
  userId     String?
  authorName String?
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([userId])
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String?
  name              String?
  role              Role       @default(USER)
  testerHubId       String?    @unique
  lastSeenBacklogAt DateTime?
  personalWorkspace Workspace? @relation("PersonalWorkspaceOwner")

  comments Comment[]

  createdTasks         Task[]               @relation("TaskCreator")
  reportedTasks        Task[]               @relation("TaskReporter")
  assignedTasks        Task[]               @relation("TaskAssignee")
  activities           TaskActivity[]
  workspaceMemberships WorkspaceMember[]
  projectMemberships   ProjectMember[]
  uploads              Upload[]
  workspaceInvites     WorkspaceInvite[]    @relation("WorkspaceInviteCreator")
  createdWikiPages     WikiPage[]           @relation("WikiPageCreatedBy")
  updatedWikiPages     WikiPage[]           @relation("WikiPageUpdatedBy")
  requestedWikiReviews WikiPage[]           @relation("WikiReviewRequestedBy")
  wikiRevisions        WikiPageRevision[]
  wikiReviewDecisions  WikiReviewDecision[]
  createdWikiThreads   WikiCommentThread[]  @relation("WikiThreadCreatedBy")
  resolvedWikiThreads  WikiCommentThread[]  @relation("WikiThreadResolvedBy")
  wikiComments         WikiComment[]
  wikiAttachments      WikiAttachment[]
  knowledgeLinks       KnowledgeLink[]

  sessions Session[]
}

model Project {
  id               String            @id @default(cuid())
  key              String            @unique
  name             String
  nextIssueNumber  Int               @default(1)
  createdAt        DateTime          @default(now())
  archivedAt       DateTime?
  tasks            Task[]
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id])
  workspaceInvites WorkspaceInvite[]
  members          ProjectMember[]
  uploads          Upload[]
  knowledge        ProjectKnowledge?
  wikiPages        WikiPage[]
  knowledgeLinks   KnowledgeLink[]

  @@index([archivedAt])
}

model Workspace {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  personalOwnerId String?           @unique
  createdAt       DateTime          @default(now())
  projects        Project[]
  members         WorkspaceMember[]
  invites         WorkspaceInvite[]
  personalOwner   User?             @relation("PersonalWorkspaceOwner", fields: [personalOwnerId], references: [id], onDelete: SetNull)
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id                 String      @id @default(cuid())
  workspaceId        String
  projectId          String?
  projectRole        ProjectRole @default(MEMBER)
  accessDurationDays Int?
  createdById        String?
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("WorkspaceInviteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([projectId])
  @@index([revokedAt])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  expiresAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, expiresAt])
}

model Upload {
  id           String   @id @default(cuid())
  storedName   String   @unique
  originalName String
  contentType  String
  size         Int
  projectId    String
  uploadedById String
  createdAt    DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([uploadedById])
}

model ProjectKnowledge {
  id          String            @id @default(cuid())
  projectId   String            @unique
  provider    KnowledgeProvider @default(DISABLED)
  externalUrl String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model WikiPage {
  id                  String             @id @default(cuid())
  projectId           String
  parentId            String?
  title               String
  slug                String
  contentMarkdown     String             @default("") @db.Text
  sortOrder           Int                @default(0)
  version             Int                @default(1)
  workflowStatus      WikiWorkflowStatus @default(DRAFT)
  reviewVersion       Int?
  approvedVersion     Int?
  reviewRequestedById String?
  reviewRequestedAt   DateTime?
  createdById         String?
  updatedById         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  archivedAt          DateTime?

  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent            WikiPage?            @relation("WikiPageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          WikiPage[]           @relation("WikiPageTree")
  createdBy         User?                @relation("WikiPageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?                @relation("WikiPageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  reviewRequestedBy User?                @relation("WikiReviewRequestedBy", fields: [reviewRequestedById], references: [id], onDelete: SetNull)
  revisions         WikiPageRevision[]
  reviewDecisions   WikiReviewDecision[]
  commentThreads    WikiCommentThread[]
  attachments       WikiAttachment[]

  @@unique([projectId, slug])
  @@index([projectId, parentId, archivedAt, sortOrder])
}

model WikiPageRevision {
  id              String   @id @default(cuid())
  pageId          String
  version         Int
  title           String
  contentMarkdown String   @db.Text
  createdById     String?
  createdAt       DateTime @default(now())

  page            WikiPage             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy       User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reviewDecisions WikiReviewDecision[]
  commentThreads  WikiCommentThread[]

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model WikiReviewDecision {
  id         String                 @id @default(uuid())
  pageId     String
  revisionId String
  reviewerId String
  decision   WikiReviewDecisionType
  comment    String?                @db.Text
  createdAt  DateTime               @default(now())

  page     WikiPage         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  revision WikiPageRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  reviewer User             @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([pageId, createdAt])
}

model WikiCommentThread {
  id           String                  @id @default(uuid())
  pageId       String
  revisionId   String
  anchorQuote  String?                 @db.Text
  status       WikiCommentThreadStatus @default(OPEN)
  createdById  String
  resolvedById String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  resolvedAt   DateTime?
  archivedAt   DateTime?

  page       WikiPage         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  revision   WikiPageRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  createdBy  User             @relation("WikiThreadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedBy User?            @relation("WikiThreadResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  comments   WikiComment[]

  @@index([pageId, status, createdAt])
}

model WikiComment {
  id         String    @id @default(uuid())
  threadId   String
  authorId   String
  body       String    @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  thread WikiCommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User              @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([threadId, createdAt])
}

model WikiAttachment {
  id           String    @id @default(uuid())
  pageId       String
  objectKey    String    @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime  @default(now())
  archivedAt   DateTime?

  page       WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([pageId, createdAt])
}

model KnowledgeLink {
  id          String            @id @default(cuid())
  taskId      String
  projectId   String
  provider    KnowledgeProvider
  documentKey String
  title       String
  url         String?
  createdById String?
  createdAt   DateTime          @default(now())

  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([taskId, provider, documentKey])
  @@index([projectId])
}

enum Status {
  NEW
  TODO
  HOLD
  IN_PROGRESS
  TESTING
  DONE
  REJECT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Role {
  ADMIN
  USER
}

enum WorkspaceRole {
  ADMIN
  MEMBER
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}

enum KnowledgeProvider {
  DISABLED
  NATIVE
  EXTERNAL
}

enum WikiWorkflowStatus {
  DRAFT
  IN_REVIEW
  APPROVED
}

enum WikiReviewDecisionType {
  APPROVED
  CHANGES_REQUESTED
}

enum WikiCommentThreadStatus {
  OPEN
  RESOLVED
}

enum ActivityType {
  CREATED
  STATUS_CHANGED
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

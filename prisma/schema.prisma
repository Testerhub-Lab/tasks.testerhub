generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id             String   @id @default(cuid())
  title          String
  description    String?
  priority       String   @default("Medium")
  dueDate        DateTime?
  tags           String[] @default([])
  attachments    String[] @default([])
  requesterName  String?
  requesterEmail String?
  status         String   @default("Open")
  projectId      String
  number         Int
  key            String   @unique
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id])
  comments       Comment[]

  @@unique([projectId, number])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  text      String
  userId    String?
  authorName String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String?
  role        Role     @default(USER)
  testerHubId String?
}

model Setting {
  id          Int      @id @default(1)
  boardPrivate Boolean @default(false)
}

model Project {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  nextIssueNumber Int      @default(1)
  createdAt       DateTime @default(now())
  tasks           Task[]
}

enum Status {
  NEW
  HOLD
  IN_PROGRESS
  TESTING
  DONE
  REJECT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Role {
  ADMIN
  USER
}

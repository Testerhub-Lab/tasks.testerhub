generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id            String   @id @default(cuid())
  title         String
  description   String?
  priority      String   @default("Medium")
  dueDate       DateTime?
  tags          String[] @default([])
  attachments   String[] @default([])
  requesterName String?
  requesterEmail String?
  status        String   @default("Open")
  createdAt     DateTime @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  text      String
  userId    String?
  createdAt DateTime @default(now())
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String?
  role        Role     @default(USER)
  testerHubId String?
}

model Setting {
  id          Int      @id @default(1)
  boardPrivate Boolean @default(false)
}

enum Status {
  NEW
  HOLD
  IN_PROGRESS
  TESTING
  DONE
  REJECT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Role {
  ADMIN
  USER
}
